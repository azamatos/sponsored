[Unit]
Description=Sponsored: reload the sponsor registers and match companies
After=docker.service
Requires=docker.service
OnFailure=sponsored-alert@%n.service
OnSuccess=sponsored-recovered@%n.service

[Service]
Type=oneshot
WorkingDirectory=/srv/sponsored
ExecStart=/usr/bin/docker compose run --rm -T pipeline registers
TimeoutStartSec=4h
