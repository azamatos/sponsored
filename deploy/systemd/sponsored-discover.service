[Unit]
Description=Sponsored: find new job boards in Common Crawl
After=docker.service
Requires=docker.service
OnFailure=sponsored-alert@%n.service
OnSuccess=sponsored-recovered@%n.service

[Service]
Type=oneshot
WorkingDirectory=/srv/sponsored
ExecStart=/usr/bin/docker compose run --rm -T pipeline discover
TimeoutStartSec=4h
